{
  "name": "hearth",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "electrobun prepare && vite build && electrobun dev",
    "build": "electrobun prepare && vite build && electrobun build --env=stable",
    "build:ui": "vite build",
    "preview": "vite preview",
    "prepare": "electrobun prepare",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p src/bun/tsconfig.json",
    "test": "vitest run && bun test src/bun",
    "probe": "bun src/bun/probe.ts",
    "bump": "bun scripts/version.mjs",
    "screenshots": "bun scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "electrobun": "2.0.5",
    "happy-dom": "^21.0.4",
    "lucide": "1.61.0",
    "playwright-core": "^1",
    "shadcn-svelte": "1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
