// Local SQLite storage: a message log with full-text search, the buffers each
// connection had open, and STS policies. The schema is the one the Rust engine
// created, so existing databases open unchanged.
//
// bun:sqlite is synchronous, so there is one connection and therefore one
// writer. Log writes are queued and committed together in a transaction, which
// keeps a burst of traffic from costing a commit per line; reads commit
// whatever is queued first so they never miss a message already received.

import { Database, type Statement } from 'bun:sqlite';
import { mkdirSync } from 'node:fs';
import { dirname } from 'node:path';
import { parse as parseMessage, type Message, param, tag } from './message';
import { formatMs, nowMs, parseMs } from './time';

const SCHEMA = `
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
CREATE TABLE IF NOT EXISTS messages (
    id INTEGER PRIMARY KEY,
    network TEXT NOT NULL,
    target TEXT NOT NULL,
    time INTEGER NOT NULL,
    msgid TEXT,
    nick TEXT NOT NULL,
    command TEXT NOT NULL,
    text TEXT NOT NULL,
    raw TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS messages_by_target ON messages (network, target, time);
CREATE UNIQUE INDEX IF NOT EXISTS messages_by_msgid ON messages (network, msgid) WHERE msgid IS NOT NULL;
CREATE VIRTUAL TABLE IF NOT EXISTS messages_fts USING fts5 (
    text, content = 'messages', content_rowid = 'id', tokenize = 'unicode61 remove_diacritics 2'
);
CREATE TRIGGER IF NOT EXISTS messages_ai AFTER INSERT ON messages BEGIN
    INSERT INTO messages_fts (rowid, text) VALUES (new.id, new.text);
END;
CREATE TRIGGER IF NOT EXISTS messages_ad AFTER DELETE ON messages BEGIN
    INSERT INTO messages_fts (messages_fts, rowid, text) VALUES ('delete', old.id, old.text);
END;
CREATE TABLE IF NOT EXISTS buffers (
    network TEXT NOT NULL,
    folded TEXT NOT NULL,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    key TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (network, folded)
);
CREATE TABLE IF NOT EXISTS sts (
    host TEXT PRIMARY KEY,
    port INTEGER NOT NULL,
    expires INTEGER NOT NULL
);
`;

/** Rows per transaction when draining the queue. */
const MAX_BATCH = 500;

/** One message to append to the log. */
export interface LogEntry {
  network: string;
  /** Case-folded buffer name. */
  target: string;
  msg: Message;
}

type Write =
  | { kind: 'log'; entry: LogEntry }
  | { kind: 'redact'; network: string; msgid: string }
  | { kind: 'rename'; network: string; from: string; to: string };

export interface SavedBuffer {
  name: string;
  kind: string;
  key: string;
}

export interface SearchHit {
  network: string;
  target: string;
  msg: Message;
}

/**
 * A log search. Every field but `limit` narrows it; without `text` it lists
 * the messages the other filters match.
 */
export interface SearchQuery {
  text: string;
  network?: string | null;
  /** Case-folded buffer name. */
  target?: string | null;
  /** Sender nick, compared case-insensitively. */
  from?: string | null;
  /** Bounds in ms, exclusive. */
  before?: number | null;
  after?: number | null;
  limit: number;
}

export interface StsPolicy {
  port: number;
  expires: number;
}

// Bounds for "no bound": integers stay exact as JS numbers.
const MAX_TIME = Number.MAX_SAFE_INTEGER;
const MIN_TIME = Number.MIN_SAFE_INTEGER;

function messages(rows: { raw: string }[]): Message[] {
  const out: Message[] = [];
  for (const { raw } of rows) {
    try {
      out.push(JSON.parse(raw));
    } catch {}
  }
  return out;
}

export class Db {
  private queue: Write[] = [];
  private scheduled = false;
  private enabled = true;
  private cache = new Map<string, Statement>();

  private constructor(private readonly db: Database) {
    db.exec(SCHEMA);
  }

  static open(path: string): Db {
    mkdirSync(dirname(path), { recursive: true });
    return new Db(new Database(path, { create: true }));
  }

  /** A private in-memory database, for tests. */
  static memory(): Db {
    return new Db(new Database(':memory:'));
  }

  private stmt(sql: string): Statement {
    let s = this.cache.get(sql);
    if (!s) this.cache.set(sql, (s = this.db.query(sql)));
    return s;
  }

  setLogging(on: boolean) {
    this.enabled = on;
  }

  logging(): boolean {
    return this.enabled;
  }

  log(entry: LogEntry) {
    if (this.enabled) this.enqueue({ kind: 'log', entry });
  }

  redact(network: string, msgid: string) {
    this.enqueue({ kind: 'redact', network, msgid });
  }

  /**
   * Move a buffer's log to a new (case-folded) name, e.g. after a channel
   * rename. Queued behind pending writes so none land under the old name.
   */
  renameTarget(network: string, from: string, to: string) {
    if (from !== to) this.enqueue({ kind: 'rename', network, from, to });
  }

  private enqueue(w: Write) {
    this.queue.push(w);
    if (!this.scheduled) {
      this.scheduled = true;
      setTimeout(() => this.flush(), 0);
    }
  }

  /** Commit every queued write now. */
  flush() {
    this.scheduled = false;
    while (this.queue.length) {
      const batch = this.queue.splice(0, MAX_BATCH);
      try {
        this.apply(batch);
      } catch (e) {
        console.error(`writing message log failed: ${e}`);
      }
    }
  }

  private apply(batch: Write[]) {
    const insert = this.stmt(
      `INSERT OR IGNORE INTO messages (network, target, time, msgid, nick, command, text, raw) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)`,
    );
    const redact = this.stmt('DELETE FROM messages WHERE network = ?1 AND msgid = ?2');
    const rename = this.stmt('UPDATE messages SET target = ?3 WHERE network = ?1 AND target = ?2');
    this.db.transaction(() => {
      for (const w of batch) {
        if (w.kind === 'log') {
          const { network, target } = w.entry;
          // Copied so the stamp doesn't leak into the caller's message.
          const msg: Message = { ...w.entry.msg, tags: { ...w.entry.msg.tags } };
          const time = (msg.tags.time !== undefined ? parseMs(msg.tags.time) : null) ?? nowMs();
          msg.tags.time ??= formatMs(time);
          insert.run(network, target, time, tag(msg, 'msgid') ?? null, msg.source?.nick ?? '', msg.command, searchableText(msg), JSON.stringify(msg));
        } else if (w.kind === 'redact') redact.run(w.network, w.msgid);
        else rename.run(w.network, w.from, w.to);
      }
    })();
  }

  /** Up to `limit` messages in `target` before `before` (ms), oldest first. */
  history(network: string, target: string, before: number | null | undefined, limit: number): Message[] {
    this.flush();
    const rows = this.stmt(
      'SELECT raw FROM messages WHERE network = ?1 AND target = ?2 AND time < ?3 ORDER BY time DESC, id DESC LIMIT ?4',
    ).all(network, target, before ?? MAX_TIME, limit) as { raw: string }[];
    return messages(rows).reverse();
  }

  /** Messages after `after` (ms), oldest first. */
  historyAfter(network: string, target: string, after: number, limit: number): Message[] {
    this.flush();
    const rows = this.stmt(
      'SELECT raw FROM messages WHERE network = ?1 AND target = ?2 AND time > ?3 ORDER BY time ASC, id ASC LIMIT ?4',
    ).all(network, target, after, limit) as { raw: string }[];
    return messages(rows);
  }

  /** Search the log, newest first. */
  search(q: SearchQuery): SearchHit[] {
    this.flush();
    const fts = ftsQuery(q.text);
    const filtered = q.from != null || q.target != null || q.before != null || q.after != null;
    if (fts === null && (q.text.trim() !== '' || !filtered)) return [];
    const filters = `(?2 IS NULL OR m.network = ?2 OR m.network LIKE ?2 || '/%')
               AND (?3 IS NULL OR m.target = ?3)
               AND (?4 IS NULL OR m.nick = ?4 COLLATE NOCASE)
               AND m.time < ?5 AND m.time > ?6`;
    const sql =
      fts !== null
        ? `SELECT m.network, m.target, m.raw FROM messages_fts f JOIN messages m ON m.id = f.rowid
           WHERE messages_fts MATCH ?1 AND ${filters} ORDER BY m.time DESC LIMIT ?7`
        : `SELECT m.network, m.target, m.raw FROM messages m
           WHERE ?1 IS NULL AND m.command IN ('PRIVMSG', 'NOTICE') AND ${filters} ORDER BY m.time DESC LIMIT ?7`;
    const rows = this.stmt(sql).all(fts, q.network ?? null, q.target ?? null, q.from ?? null, q.before ?? MAX_TIME, q.after ?? MIN_TIME, q.limit) as {
      network: string;
      target: string;
      raw: string;
    }[];
    const hits: SearchHit[] = [];
    for (const r of rows) {
      try {
        hits.push({ network: r.network, target: r.target, msg: JSON.parse(r.raw) });
      } catch {}
    }
    return hits;
  }

  /** Forget everything logged for a server (and its bouncer networks). */
  forgetServer(server: string) {
    this.flush();
    const like = `${server}/%`;
    this.db.transaction(() => {
      this.stmt('DELETE FROM messages WHERE network = ?1 OR network LIKE ?2').run(server, like);
      this.stmt('DELETE FROM buffers WHERE network = ?1 OR network LIKE ?2').run(server, like);
    })();
  }

  clearLogs() {
    this.flush();
    this.db.exec('DELETE FROM messages');
    this.db.exec("INSERT INTO messages_fts (messages_fts) VALUES ('rebuild')");
    this.db.exec('VACUUM');
  }

  buffers(network: string): SavedBuffer[] {
    return this.stmt('SELECT name, kind, key FROM buffers WHERE network = ?1 ORDER BY folded').all(network) as SavedBuffer[];
  }

  /** Replace the saved buffer list for a connection. `fold` case-folds names. */
  saveBuffers(network: string, buffers: SavedBuffer[], fold: (s: string) => string) {
    this.db.transaction(() => {
      this.stmt('DELETE FROM buffers WHERE network = ?1').run(network);
      const insert = this.stmt('INSERT OR REPLACE INTO buffers (network, folded, name, kind, key) VALUES (?1, ?2, ?3, ?4, ?5)');
      for (const b of buffers) insert.run(network, fold(b.name), b.name, b.kind, b.key ?? '');
    })();
  }

  stsPolicy(host: string): StsPolicy | null {
    const row = this.stmt('SELECT port, expires FROM sts WHERE host = ?1').get(host.toLowerCase()) as StsPolicy | null;
    return row && row.expires > nowMs() ? { port: row.port, expires: row.expires } : null;
  }

  /** Record (or with `durationSecs <= 0`, drop) a host's STS policy. */
  setStsPolicy(host: string, port: number, durationSecs: number) {
    const h = host.toLowerCase();
    try {
      if (durationSecs <= 0) this.stmt('DELETE FROM sts WHERE host = ?1').run(h);
      else this.stmt('INSERT OR REPLACE INTO sts (host, port, expires) VALUES (?1, ?2, ?3)').run(h, port, nowMs() + durationSecs * 1000);
    } catch (e) {
      console.warn(`saving STS policy failed: ${e}`);
    }
  }

  close() {
    this.flush();
    this.cache.clear();
    this.db.close();
  }
}

/** The plain text of a message body, for indexing. */
function searchableText(m: Message): string {
  switch (m.command) {
    case 'PRIVMSG':
    case 'NOTICE': {
      let body = param(m, 1);
      if (body.startsWith('\x01ACTION ')) body = body.slice(8).replace(/\x01+$/, '');
      return stripFormatting(body);
    }
    case 'TOPIC':
      return stripFormatting(param(m, 1));
    case 'PART':
    case 'KICK':
      return stripFormatting(m.params.at(-1) ?? '');
    default:
      return '';
  }
}

const isDigit = (c: string | undefined) => c !== undefined && c >= '0' && c <= '9';
const isHex = (s: string) => /^[0-9a-fA-F]{6}$/.test(s);

/** Remove mIRC formatting codes. */
export function stripFormatting(s: string): string {
  let out = '';
  for (let i = 0; i < s.length; i++) {
    const c = s[i];
    if ('\x02\x0f\x11\x16\x1d\x1e\x1f'.includes(c)) continue;
    if (c === '\x03') {
      let fg = false;
      for (let n = 0; n < 2 && isDigit(s[i + 1]); n++) {
        i++;
        fg = true;
      }
      if (fg && s[i + 1] === ',' && isDigit(s[i + 2])) {
        i++;
        for (let n = 0; n < 2 && isDigit(s[i + 1]); n++) i++;
      }
    } else if (c === '\x04') {
      if (isHex(s.slice(i + 1, i + 7))) {
        i += 6;
        if (s[i + 1] === ',' && isHex(s.slice(i + 2, i + 8))) i += 7;
      }
    } else out += c;
  }
  return out;
}

/**
 * Turn user input into an FTS5 query: every word must match, the last one as
 * a prefix so results appear while typing.
 */
function ftsQuery(input: string): string | null {
  const words = input
    .split(/\s+/)
    .map((w) => w.replace(/^[^\p{Alphabetic}\p{N}#@]+|[^\p{Alphabetic}\p{N}#@]+$/gu, ''))
    .filter((w) => w !== '')
    .map((w) => `"${w.replaceAll('"', '""')}"`);
  return words.length ? words.join(' ') + '*' : null;
}

export { parseMessage };
