{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "paths": {
      "electrobun/main": [
        "../../.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun": [
        "../../.hutch/devkit/api/sdks/main/index.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts",
    "../../electrobun.config.ts"
  ]
}
